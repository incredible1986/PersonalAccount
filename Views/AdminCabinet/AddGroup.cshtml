@model AddGroupViewModel

<div class="container d-flex align-content-center justify-content-center">
    <div class="card w-50">
        <header class="card-header">
            <h1 class="text-center">Добавить группу</h1>
        </header>
        <form class="card-body" method="post">
            <div class="alert-danger alert" asp-validation-summary="ModelOnly"></div>
            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input class="form-control" asp-for="Name" autocomplete="off" />
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Description"></label>
                <textarea class="form-control" asp-for="Description"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="ImageUrl"></label>
                <input class="form-control" asp-for="ImageUrl" />
            </div>
            <button class="btn btn-primary w-100" type="submit">Добавить</button>
        </form>
    </div>
</div>